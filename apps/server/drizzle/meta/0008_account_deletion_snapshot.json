            "user_id"
          ],
          "columnsTo": [
            "id"
          ],
          "onDelete": "no action",
          "onUpdate": "no action"
        }
      },
      "compositePrimaryKeys": {},
      "uniqueConstraints": {},
      "checkConstraints": {
        "strava_delivery_authority_kind": {
          "name": "strava_delivery_authority_kind",
          "value": "json_valid(authority) AND COALESCE(json_extract(authority,'$.kind') IN ('consented','stopped'),0)"
        },
        "strava_delivery_progress_kind": {
          "name": "strava_delivery_progress_kind",
          "value": "json_valid(progress) AND COALESCE(json_extract(progress,'$.kind') IN ('queued','preparing','submitting','submission_unknown','processing','delivered','submission_rejected','processing_rejected'),0)"
        },
        "strava_delivery_own_ride": {
          "name": "strava_delivery_own_ride",
          "value": "COALESCE(json_extract(authority,'$.consent.rideId') = ride_id AND json_type(authority,'$.consent') = 'object',0)"
        },
        "strava_delivery_authority_state": {
          "name": "strava_delivery_authority_state",
          "value": "COALESCE(CASE json_extract(authority,'$.kind') WHEN 'consented' THEN json_type(authority,'$.consentedAtMs') = 'integer' WHEN 'stopped' THEN json_type(authority,'$.stoppedAtMs') = 'integer' AND json_extract(authority,'$.reason') IN ('disconnect','credentials','policy') END,0)"
        },
        "strava_delivery_progress_state": {
          "name": "strava_delivery_progress_state",
          "value": "COALESCE(CASE json_extract(progress,'$.kind') WHEN 'queued' THEN json_type(progress,'$.notBeforeMs') = 'integer' WHEN 'preparing' THEN json_type(progress,'$.owner') = 'text' AND json_type(progress,'$.leaseUntilMs') = 'integer' WHEN 'submitting' THEN json_type(progress,'$.attemptId') = 'text' AND json_type(progress,'$.startedAtMs') = 'integer' AND json_type(progress,'$.leaseUntilMs') = 'integer' WHEN 'submission_unknown' THEN json_type(progress,'$.attemptId') = 'text' AND json_extract(progress,'$.reason') IN ('response_lost','crash','protocol') WHEN 'processing' THEN json_type(progress,'$.nextPollAtMs') = 'integer' AND json_extract(progress,'$.issue') IN ('none','authorization','rate_limit','network','protocol') WHEN 'delivered' THEN json_type(progress,'$.activityId') = 'text' AND json_type(progress,'$.confirmedAtMs') = 'integer' WHEN 'submission_rejected' THEN json_extract(progress,'$.reason') IN ('authorization','rate_limit','file','provider') WHEN 'processing_rejected' THEN json_extract(progress,'$.reason') = 'provider_error' END,0)"
        },
        "strava_delivery_receipt": {
          "name": "strava_delivery_receipt",
          "value": "CASE WHEN json_extract(progress,'$.kind') IN ('processing','delivered','processing_rejected') THEN COALESCE(json_type(progress,'$.receipt.uploadId') = 'text' AND json_type(progress,'$.receipt.externalId') = 'text',0) ELSE 1 END"
        }
      }
    },
