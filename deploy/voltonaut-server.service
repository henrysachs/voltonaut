[Unit]
Description=Voltonaut API server
Documentation=https://github.com/henrysachs/voltonaut
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=voltonaut
Group=voltonaut
WorkingDirectory=/opt/voltonaut/current
Environment=NODE_ENV=production
ExecStart=/opt/voltonaut/mise/shims/node dist/main.js
Restart=always
RestartSec=3

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/voltonaut/current

[Install]
WantedBy=multi-user.target
