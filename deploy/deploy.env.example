LITESTREAM_ENDPOINT=https://storage.example.invalid
LITESTREAM_BUCKET=replace-with-approved-external-bucket
LITESTREAM_ACCESS_KEY_ID=replace-with-approved-key-id
LITESTREAM_SECRET_ACCESS_KEY='replace-with-approved-backup-secret'
