# Read by Docker Compose, never by shell source/eval. Quote literal $ with single quotes.
AUTH_MODE=oidc
CLIENT_ORIGIN=https://voltonaut.stammkneipe.dev
# Liste der Anmeldeanbieter (IDs aus [a-z0-9-]). compose.yaml reicht die Sätze
# OIDC_CLOUDFLARE_* und OIDC_AUTHENTIK_* durch; weitere IDs brauchen einen Eintrag dort.
OIDC_PROVIDERS=cloudflare,authentik
OIDC_CLOUDFLARE_DISPLAY_NAME='Cloudflare Access'
OIDC_CLOUDFLARE_ISSUER=https://identity.example.invalid/oidc/application
OIDC_CLOUDFLARE_CLIENT_ID=replace-with-approved-client-id
OIDC_CLOUDFLARE_CLIENT_SECRET='replace-with-approved-secret'
OIDC_CLOUDFLARE_REDIRECT_URI=https://api.voltonaut.stammkneipe.dev/v1/auth/oidc/cloudflare/callback
# authentik: Issuer exakt wie im Provider angezeigt, mit Slash am Ende.
OIDC_AUTHENTIK_DISPLAY_NAME=authentik
OIDC_AUTHENTIK_ISSUER=https://authentik.example.invalid/application/o/voltonaut/
OIDC_AUTHENTIK_CLIENT_ID=replace-with-approved-client-id
OIDC_AUTHENTIK_CLIENT_SECRET='replace-with-approved-secret'
OIDC_AUTHENTIK_REDIRECT_URI=https://api.voltonaut.stammkneipe.dev/v1/auth/oidc/authentik/callback
# Optional je Anbieter (Standard: "openid email", true, RS256):
# OIDC_AUTHENTIK_SCOPES='openid email'
# OIDC_AUTHENTIK_REQUIRE_EMAIL_VERIFIED=true
# OIDC_AUTHENTIK_ID_TOKEN_ALG=RS256
# Optional backup only. Copy compose.backup.yaml and explicitly select it with
# VOLTONAUT_BACKUP_FILE=compose.backup.yaml when invoking deploy.sh.
# No backup resources are created by the default deployment.
# LITESTREAM_ENDPOINT=https://storage.example.invalid
# LITESTREAM_BUCKET=replace-with-approved-external-bucket
# LITESTREAM_ACCESS_KEY_ID=replace-with-approved-key-id
# LITESTREAM_SECRET_ACCESS_KEY='replace-with-approved-backup-secret'
