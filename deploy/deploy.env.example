# Read by Docker Compose, never by shell source/eval. Quote literal $ with single quotes.
AUTH_MODE=oidc
CLIENT_ORIGIN=https://voltonaut.stammkneipe.dev
OIDC_ISSUER=https://identity.example.invalid/oidc/application
OIDC_CLIENT_ID=replace-with-approved-client-id
OIDC_CLIENT_SECRET='replace-with-approved-secret'
OIDC_REDIRECT_URI=https://api.voltonaut.stammkneipe.dev/v1/auth/oidc/callback
# Optional backup only. Copy compose.backup.yaml and explicitly select it with
# VOLTONAUT_BACKUP_FILE=compose.backup.yaml when invoking deploy.sh.
# No backup resources are created by the default deployment.
# LITESTREAM_ENDPOINT=https://storage.example.invalid
# LITESTREAM_BUCKET=replace-with-approved-external-bucket
# LITESTREAM_ACCESS_KEY_ID=replace-with-approved-key-id
# LITESTREAM_SECRET_ACCESS_KEY='replace-with-approved-backup-secret'
